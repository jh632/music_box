CONFIG_IDF_TARGET="esp32s3"
CONFIG_PERIPH_CTRL_FUNC_IN_IRAM=y
CONFIG_LWIP_DHCP_OPTIONS_LEN=69
CONFIG_MBEDTLS_GCM_SUPPORT_NON_AES_CIPHER=n
CONFIG_U8G2_DISPLAY_DRIVER_SSD1306=y
